{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AIRA2 API",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": [
        "aira2.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "5080"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
