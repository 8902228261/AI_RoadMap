# Copy to .env and edit if you need local overrides.
# AIRA2 first loads the LangChain Academy keys from COURSE_ENV_PATH.

COURSE_ENV_PATH=D:\Study\Langchain\lca-lc-foundations\.env

# Same Postgres database that the C# AIRA project already uses.
DATABASE_URL=postgresql://aira:aira@localhost:5432/aira

# Same dashboard files. Do not copy them; we serve this folder.
AIRA_UI_PATH=D:\Study\AIRA\ui\aira-dashboard

# Course used gpt-5-nano. If that model is not on your account, try gpt-4o-mini.
CHAT_MODEL=gpt-5-nano
EMBEDDING_MODEL=text-embedding-3-small

# Stop the C# Aira.Api first, then run AIRA2 on the same port so the UI works.
AIRA2_HOST=127.0.0.1
AIRA2_PORT=5080

# Optional: copy LANGSMITH_* from the course .env to see traces at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aira2
